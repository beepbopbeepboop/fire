[ExprStmt(value=StringLiteral(value='"""Example: Using imports from modules.\n\nThis example demonstrates:\n1. Importing functions from helper modules\n2. Using imported functions in main program\n3. Matrix multiply operator (via __matmul__ method calls)\n\nTo compile:\n  python mojo_compiler.py < example_imports.mojo > /tmp/example.c\n  gcc-mp-15 -fgimple -I runtime -o /tmp/example /tmp/example.c\n"""')), FromImportStmt(module='test_helper', names=[('double', None), ('add', None)], wildcard=False), FunctionDef(name='main', params=[], return_type='Int', body=[VarDecl(name='x', type_ann='Int', value=IntLiteral(value=10)), VarDecl(name='y', type_ann='Int', value=IntLiteral(value=20)), VarDecl(name='doubled_x', type_ann='Int', value=CallExpr(func=IdentExpr(name='double'), args=[IdentExpr(name='x')])), VarDecl(name='sum_result', type_ann='Int', value=CallExpr(func=IdentExpr(name='add'), args=[IdentExpr(name='doubled_x'), IdentExpr(name='y')])), ReturnStmt(value=IdentExpr(name='sum_result'))], decorators=[], param_convs={})]