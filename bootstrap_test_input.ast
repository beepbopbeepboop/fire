[ExprStmt(value=StringLiteral(value='"""\nSimple test input for bootstrap verification.\nThis file will be compiled through all three stages to verify correctness.\n"""')), FunctionDef(name='add', params=[('x', None), ('y', None)], return_type=None, body=[ReturnStmt(value=BinaryOp(op='+', left=IdentExpr(name='x'), right=IdentExpr(name='y')))], decorators=[], param_convs={}), FunctionDef(name='factorial', params=[('n', None)], return_type=None, body=[IfStmt(condition=BinaryOp(op='<=', left=IdentExpr(name='n'), right=IntLiteral(value=1)), then_body=[ReturnStmt(value=IntLiteral(value=1))], elifs=[], else_body=[ReturnStmt(value=BinaryOp(op='*', left=IdentExpr(name='n'), right=CallExpr(func=IdentExpr(name='factorial'), args=[BinaryOp(op='-', left=IdentExpr(name='n'), right=IntLiteral(value=1))])))])], decorators=[], param_convs={}), FunctionDef(name='main', params=[], return_type=None, body=[AssignStmt(target=IdentExpr(name='a'), value=CallExpr(func=IdentExpr(name='add'), args=[IntLiteral(value=2), IntLiteral(value=3)])), AssignStmt(target=IdentExpr(name='b'), value=CallExpr(func=IdentExpr(name='factorial'), args=[IntLiteral(value=5)])), ExprStmt(value=CallExpr(func=IdentExpr(name='print'), args=[IdentExpr(name='a')])), ExprStmt(value=CallExpr(func=IdentExpr(name='print'), args=[IdentExpr(name='b')]))], decorators=[], param_convs={}), IfStmt(condition=BinaryOp(op='==', left=IdentExpr(name='__name__'), right=StringLiteral(value="'__main__'")), then_body=[ExprStmt(value=CallExpr(func=IdentExpr(name='main'), args=[]))], elifs=[], else_body=None)]