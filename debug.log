def parse(text, path=''):
    """Parses 'think' source files into a structured dict."""
    try:
        lines = text.splitlines()
        line_count = len(lines)
        byte_count = len(text)
        symbols = []
        imports = []
        
        # Simple heuristic for top-level definitions
        current_def = None
        for i, line in enumerate(lines):
            stripped = line.strip()
            if not stripped or stripped.startswith('#'):
                continue
            
            # Check for import-like statements (though 'think' might not have them)
            if stripped.startswith(('import ', 'from ', 'include ', 'use ', 'require ')):
                imports.append(stripped)
                continue

            # Detect variable assignment: name = ...
            if '=' in stripped and not stripped.startswith('for ') and not stripped.startswith('if ') and not stripped.startswith('while '):
                # Basic check for simple assignment
                parts = stripped.split('=', 1)
                if len(parts) == 2:
                    name_part = parts[0].strip()
                    # Handle list/dict literals or function calls on RHS? 
                    # We just capture the LHS identifier if it looks like a var
                    if name_part and not name_part.startswith('('):
                        # Check if it's a simple variable or subscript
                        # For simplicity, assume top-level names are variables unless they look like functions
                        kind = 'variable'
                        sig = stripped
                        
                        # Check if it's a function definition (def ...)
                        if stripped.startswith('def '):
                            kind = 'function'
                        
                        # Check if it's a class
                        if stripped.startswith('class '):
                            kind = 'class'

                        symbols.append({
                            'name': name_part.split('.')[-1].split('[')[0],
                            'kind': kind,
                            'line_start': i + 1,
                            'line_end': i + 1,
                            'signature': sig
                        })
            elif stripped.startswith('def '):
                # Function definition already handled above mostly, but ensure name extraction
                pass
            elif stripped.startswith('class '):
                pass

        return {
            'path': path,
            'file_type': 'think',
            'line_count': line_count,
            'byte_count': byte_count,
            'symbols': symbols,
            'imports': imports
        }
    except Exception as e:
        return {
            'path': path,
            'file_type': 'think',
            'error': str(e),
            'line_count': 0,
            'byte_count': len(text) if text else 0,
            'symbols': [],
            'imports': []
        }
