    """Parses Mojo source code structure into a structured dict."""
    try:
        lines = text.splitlines()
        line_count = len(lines)
        byte_count = len(text)
        symbols = []
        imports = []
        
        # Regex for function definitions: fn name(args) -> type:
        func_pattern = r'^fn\s+(\w+)\s*\(([^)]*)\)\s*(?:->\s*(\w+))?\s*:'
        
        current_func = None
        
        for i, line in enumerate(lines):
            stripped = line.strip()
            
            # Handle imports (use/import/include)
            if stripped.startswith(('use ', 'import ', '#include ')):
                imports.append(stripped)
                continue
                
            match = re.match(func_pattern, stripped)
            if match:
                name = match.group(1)
                args_str = match.group(2).strip()
                ret_type = match.group(3) or ""
                
                # Determine line end by looking for next def or end of file
                # Simple heuristic: find next 'fn' at start of line or EOF
                end_line = i + 1
                for j in range(i + 1, len(lines)):
                    if re.match(r'^fn\s+\w+', lines[j].strip()):
                        break
                    end_line = j + 1
                
                signature = f"fn {name}({args_str}) -> {ret_type}"
                
                symbols.append({
                    "name": name,
                    "kind": "function",
                    "line_start": i + 1,
                    "line_end": end_line,
                    "signature": signature
                })
        
        return {
