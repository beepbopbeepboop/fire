def parse(text, path=''):
    """Parse Mojo source text into a structured dict."""
    try:
        lines = text.splitlines()
        line_count = len(lines)
        byte_count = len(text)
        symbols = []
        imports = []
        
        # Regex patterns for Mojo constructs
        fn_pat = r'^fn\s+(\w+)\s*\((.*?)\)\s*(?:->\s*(\w+))?\s*:'
        struct_pat = r'^struct\s+(\w+)\s*:'
        target_pat = r'^target\s+(\w+)\s*:'
        
        for i, line in enumerate(lines):
            stripped = line.strip()
            if not stripped or stripped.startswith('#'):
                continue
            
            # Check imports (mojo uses 'import' like python)
            if stripped.startswith('import ') or stripped.startswith('from '):
                imports.append(stripped)
                continue
                
            m_fn = __import__('re').match(fn_pat, stripped)
            if m_fn:
                name = m_fn.group(1)
                args = m_fn.group(2)
                ret = m_fn.group(3) or ''
                sig = f"fn {name}({args}) -> {ret}"
                # Find end of function (next non-indented line or end of file)
                end_line = i + 1
                indent_level = len(line) - len(line.lstrip())
                for j in range(i + 1, line_count):
                    next_line = lines[j]
                    if not next_line.strip(): continue
                    curr_indent = len(next_line) - len(next_line.lstrip())
                    if curr_indent <= indent_level and not next_line.strip().startswith('#'):
                        break
                    end_line = j + 1
                symbols.append({
                    'name': name,
                    'kind': 'function',
                    'line_start': i + 1,
                    'line_end': end_line,
                    'signature': sig
                })
                continue

            m_struct = __import__('re').match(struct_pat, stripped)
            if m_struct:
                name = m_struct.group(1)
                # Find end of struct
                end_line = i + 1
                indent_level = len(line) - len(line.lstrip())
                for j in range(i + 1, line_count):
                    next_line = lines[j]
                    if not next_line.strip(): continue
                    curr_indent = len(next_line) - len(next_line.lstrip())
                    if curr_indent <= indent_level and not next_line.strip().startswith('#'):
                        break
                    end_line = j + 1
                symbols.append({
                    'name': name,
                    'kind': 'struct',
                    'line_start': i + 1,
                    'line_end': end_line,
                    'signature': f"struct {name}"
                })
                continue

            m_target = __import__('re').match(target_pat, stripped)
            if m_target:
                name = m_target.group(1)
                symbols.append({
                    'name': name,
                    'kind': 'target',
                    'line_start': i + 1,
                    'line_end': i + 1,
                    'signature': f"target {name}"
                })

        return {
            'path': path,
            'file_type': 'mojo',
            'line_count': line_count,
            'byte_count': byte_count,
            'symbols': symbols,
            'imports': imports
        }
    except Exception as e:
        return {
            'path': path,
            'file_type': 'mojo',
            'error': str(e),
            'line_count': 0,
            'byte_count': len(text) if text else 0,
            'symbols': [],
            'imports': []
        }
