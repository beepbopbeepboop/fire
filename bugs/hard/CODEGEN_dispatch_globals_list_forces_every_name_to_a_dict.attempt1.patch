+    '_STMT_DISPATCH': 'MojoDict *',
+    '_EXPR_DISPATCH': 'MojoDict *',
+    '_BIN_OPS': 'MojoDict *',
+    '_TYPE_MAP': 'MojoDict *',
+    '_SIGNED': 'MojoDict *',
+    '_UNSIGNED': 'MojoDict *',
+    '_FLOAT': 'MojoDict *',
+    '_LIBM_FN_RETVALS': 'MojoDict *',
+    '_SELFHOST_EXTRA_FIELD_CACHE': 'MojoDict *',
+    # ── `frozenset`s and set literals ──
+    '_CMP_OPS': 'MojoSet *',
+    '_C_KEYWORDS': 'MojoSet *',
+    '_C_RESERVED_FUNCS': 'MojoSet *',
+    '_FORCE_RENAME_RESERVED': 'MojoSet *',
+    '_CPP_KEYWORD_FIELDS': 'MojoSet *',
+    '_C_PARAM_EXTRA_KEYWORDS': 'MojoSet *',
+    '_PSEUDO_DUNDER_ATTRS': 'MojoSet *',
+    '_LIST_RETURNING_METHODS': 'MojoSet *',
+    '_STR_RETURNING_METHODS': 'MojoSet *',
+    '_SCALAR_INT_TYPES': 'MojoSet *',
+    '_SCALAR_FLOAT_TYPES': 'MojoSet *',
+    # ── plain strings ──
+    '_CPP_CALLABLE_CTYPE': 'char *',
+    '_CPP_CALLABLE_CTYPE_1ARG': 'char *',
+    '_UNKNOWN_FIELD_CTYPE': 'char *',
+    # ── no typed accessor: the box ──
+    '_FIXED_ARRAY_ANN_RE': 'int64_t',
+}
+
+# The two structures answer two different questions -- "is this one of ours?"
+# and "what C type does it have?" -- and the second is only meaningful for a
+# name in the first. Checked here rather than left to a reader, because the
+# failure mode is silent in one direction (an extra key is never read) and a
+# wall of missing-field errors in the other.
+assert set(_DISPATCH_TABLE_FORCED_CTYPES) == set(_DISPATCH_TABLE_GLOBAL_NAMES), (
+    '_DISPATCH_TABLE_FORCED_CTYPES must cover exactly '
+    f'_DISPATCH_TABLE_GLOBAL_NAMES; missing '
+    f'{sorted(set(_DISPATCH_TABLE_GLOBAL_NAMES) - set(_DISPATCH_TABLE_FORCED_CTYPES))}, '
+    f'extra {sorted(set(_DISPATCH_TABLE_FORCED_CTYPES) - set(_DISPATCH_TABLE_GLOBAL_NAMES))}')
+
