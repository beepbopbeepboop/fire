# selfhost A/B scratch harness
_ab_root.py
_d.py
_abt*.mojo
_abt*.ci
_*.nc
_*.py.orig
mojoc.dbg

# test_ab_native.py's scratch: sources and their collected .ci/.tok/.ast/.pyi
# live under .tmp/ (in the worktree, which `_is_selfhost_source_dir` requires),
# but the compiler writes its output artifacts into the CWD it is handed — the
# repo root — so these can appear beside the sources while a run is in flight.
# The `abt<pid>_<hex>_` prefix is this run's; the tag is what makes a
# concurrent run's artifacts distinguishable (see test_ab_native.py).
abt*_*.ci
abt*_*.tok
abt*_*.ast
abt*_*.pyi

# tools/codeindex.py derived artifact -- rebuild with `python3 tools/codeindex.py build`
.codeindex.sqlite3

# aside/bside A/B dump-compare harness (tools/ab_*.py, `make aside bside`)
/aside/
/bside/
/ab.mk
/.ab_locks/

# Lean 4 compiled objects + formal proof/build outputs (rebuild:
# `pixi run prooflib` / `tools/proof.sh <stem>` / `fire.py formalbuild`)
*.olean
*.olean.srcsha256
# The flock file `formal.lean.ensure_library` takes while building an .olean.
# Never meaningful between runs, and it must NOT be gitignored as a pattern
# that would also swallow a real build product — hence the explicit name.
*.olean.buildlock
/output/
# `fire.py build --formal` writes <stem>_proof.lean next to the source, the
# same place it writes <stem>.aout (gitignored above). test_formal.py instead
# keeps artifacts under output/, so a proof built by hand lands in the tree
# untracked; these are rebuildable from the source, not sources themselves.
*_proof.lean

# a compiled binary dropped at the repo root by `fire.py build <path>`
/mine
